# Django
DJANGO_SECRET_KEY=django-insecure-!@#&*^%$#@!$%^&*()_+1234567890abcdefghijklmnopqrstuvwxyz
DEBUG_SETTING=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ondigitalocean.app,api.phoenixvanz.com,dev.phoenixvanz.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://phoenixvanz.com,https://www.phoenixvanz.com,https://api.phoenixvanz.com,https://dev.phoenixvanz.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://phoenixvanz.com,https://www.phoenixvanz.com
SITE_URL=http://127.0.0.1:8000

# Cart application credential. Generate 32 random bytes and encode them as
# 64 lowercase hex characters. This placeholder is rejected.
CART_APP_CREDENTIAL=replace-with-64-lowercase-hex-chars

# Cart rate-limit HMAC key. Generate 32 random bytes and encode them as
# 64 lowercase hex characters. Empty and this placeholder are rejected when a
# counter subject key is derived. Routes read it only when
# CART_RATE_LIMIT_ENABLED is true.
# Do not reuse the application credential or DJANGO_SECRET_KEY.
CART_RATE_LIMIT_HMAC_KEY=replace-with-64-lowercase-hex-chars

# Optional cart rate limits. Leave disabled until numerical quotas are approved.
# CART_RATE_LIMIT_ENABLED accepts true/false, not a non-empty string.
# CART_RATE_LIMIT_POLICIES is a JSON object with exactly issuance,
# failed_access and authenticated_cart. Each value is a list of
# {"window_seconds": 60, "limit": 1}. No production quota is filled in here.
# CART_FRONTEND_RATE_LIMIT_POLICIES is a separate JSON object with exactly
# csrf and reset, using that same descriptor shape. Only POST /api/cart/budget/
# reads it, and only when enforcement is enabled. Ordinary cart routes do not.
CART_RATE_LIMIT_ENABLED=false
CART_RATE_LIMIT_POLICIES=
CART_FRONTEND_RATE_LIMIT_POLICIES=

# PostgreSQL. Leave unset locally to use db.sqlite3.
DATABASE_URL=

# DigitalOcean Spaces. Create a new key before production deployment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=phoenixvanz
AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
AWS_S3_REGION_NAME=fra1
AWS_S3_CUSTOM_DOMAIN=phoenixvanz.fra1.digitaloceanspaces.com

# Contact proxy. Required in production; use a long server-side secret.
# This value must never be exposed through Nuxt public runtime configuration.
CONTACT_PROXY_SECRET=local-development-contact-proxy-secret

# Email. The console backend is for DEBUG development only.
# Set a real SMTP or other delivery backend in production.
# Do not put the customer address in DEFAULT_FROM_EMAIL.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
CONTACT_RECIPIENT_EMAIL=
