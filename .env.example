# Django
DJANGO_SECRET_KEY=django-insecure-!@#&*^%$#@!$%^&*()_+1234567890abcdefghijklmnopqrstuvwxyz
DEBUG_SETTING=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ondigitalocean.app,api.phoenixvanz.com,dev.phoenixvanz.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://phoenixvanz.com,https://www.phoenixvanz.com,https://api.phoenixvanz.com,https://dev.phoenixvanz.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://phoenixvanz.com,https://www.phoenixvanz.com
SITE_URL=http://127.0.0.1:8000

# Cart application credential. Generate 32 random bytes and encode them as
# 64 lowercase hex characters. This placeholder is rejected.
CART_APP_CREDENTIAL=replace-with-64-lowercase-hex-chars

# Cart rate-limit HMAC key. Generate 32 random bytes and encode them as
# 64 lowercase hex characters. Empty and this placeholder are rejected when a
# counter subject key is derived. Cart routes do not use it yet.
# Do not reuse the application credential or DJANGO_SECRET_KEY.
CART_RATE_LIMIT_HMAC_KEY=replace-with-64-lowercase-hex-chars

# PostgreSQL. Leave unset locally to use db.sqlite3.
DATABASE_URL=

# DigitalOcean Spaces. Create a new key before production deployment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=phoenixvanz
AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
AWS_S3_REGION_NAME=fra1
AWS_S3_CUSTOM_DOMAIN=phoenixvanz.fra1.digitaloceanspaces.com
